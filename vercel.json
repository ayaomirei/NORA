{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_API_SAME_ORIGIN": "1"
  },
  "functions": {
    "src/app/api/[[...path]]/route.ts": {
      "maxDuration": 60
    }
  }
}
