# PostgreSQL (Neon / Vercel Postgres). Для локального Postgres:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nora"

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

PORT=3001
JWT_SECRET=change-me-in-production

# Через запятую; пусто = разрешить любой origin (удобно в dev)
CORS_ORIGINS=http://localhost:3000

# 2GIS: только геокодинг мест и пешеходные маршруты (карта остаётся MapLibre)
# Ключ: https://platform.2gis.ru/
DGIS_API_KEY=

# Опционально: LLM для разбора «опиши день словами» (иначе работают правила в браузере)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
